# Copy this file to .env and fill in your own values. Never commit .env.
# Get a token at https://huggingface.co/settings/tokens → "Fine-grained" → tick
# "Make calls to Inference Providers" (needed for the LLM) and "Read access to public repos".
HF_TOKEN=hf_your_token_here

# Supabase (Project Settings → API Keys). The backend needs the SECRET key (sb_secret_...):
# it bypasses Row Level Security, so it must ONLY live in this file — never in web/.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_your_key_here

# LLM provider key (see llm.provider / llm.api_key_env in config.yaml). Free tiers, no card needed:
# Cerebras: https://cloud.cerebras.ai → API Keys      Groq: https://console.groq.com/keys
CEREBRAS_API_KEY=csk-your_key_here
# GROQ_API_KEY=gsk_your_key_here
