# Copy to .env.local (git-ignored) and fill in from Supabase → Project Settings → API Keys.
# Only the PUBLISHABLE key belongs here — everything prefixed VITE_ is shipped to the browser.
# Never put the secret / service_role key in this file.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Python backend (FastAPI). Leave unset to use http://localhost:8000
# VITE_API_URL=http://localhost:8000
